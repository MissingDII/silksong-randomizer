<Project Sdk="Microsoft.NET.Sdk" InitialTargets="Test">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<AssemblyName>Silkipelago</AssemblyName>
		<Product>Archipelago Silksong Implementation</Product>
		<Version>1.0.0</Version>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>latest</LangVersion>
		<RestoreAdditionalProjectSources>
			https://api.nuget.org/v3/index.json;
			https://nuget.bepinex.dev/v3/index.json;
		</RestoreAdditionalProjectSources>
		<RootNamespace>Silkipelago</RootNamespace>
		<DebugType>Full</DebugType>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <Optimize>True</Optimize>
	  <DebugType>portable</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <Optimize>False</Optimize>
	  <DebugType>portable</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.0" />
		<PackageReference Include="Archipelago.MultiClient.Net.Analyzers" Version="2.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
		<PackageReference Include="BepInEx.Core" Version="5.*" />
		<PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
		<PackageReference Include="KaitoKid.ArchipelagoUtilities.AssetDownloader" Version="3.1.4" />
		<PackageReference Include="KaitoKid.ArchipelagoUtilities.Net" Version="3.1.4" />
		<PackageReference Include="UnityEngine.Modules" Version="6000.0.50" IncludeAssets="compile" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup Label="UserMacros">
		<SteamAppsPath Condition="'$(SteamAppsPath)' == ''">$([System.Environment]::GetEnvironmentVariable('STEAMAPPS_FOLDER'))</SteamAppsPath>
		<GamePath>$(SteamAppsPath)\common\Hollow Knight Silksong\</GamePath>
		<LibrariesPath>$(GamePath)Hollow Knight Silksong_Data\Managed\</LibrariesPath>
		<PluginsPath>$(GamePath)BepInEx\plugins\Silkipelago\</PluginsPath>
		<BepInExLauncher>Hollow Knight Silksong.exe</BepInExLauncher>
	</PropertyGroup>

	<Target Name="Test">
		<Message Text="SteamAppsPath: $(SteamAppsPath)" Importance="high" />
		<Message Text="GamePath: $(GamePath)" Importance="high" />
		<Message Text="PluginsPath: $(PluginsPath)" Importance="high" />
		<Message Text="LibrariesPath: $(LibrariesPath)" Importance="high" />
	</Target>

	<ItemGroup>
	  <Reference Include="Assembly-CSharp">
	    <HintPath>$(LibrariesPath)Assembly-CSharp.dll</HintPath>
	  </Reference>
	  <Reference Include="com.rlabrecque.steamworks.net">
	    <HintPath>$(LibrariesPath)com.rlabrecque.steamworks.net.dll</HintPath>
	  </Reference> 
	  <Reference Include="PlayMaker">
	    <HintPath>$(LibrariesPath)PlayMaker.dll</HintPath>
	  </Reference>
	</ItemGroup>

	<Target Name="Copy mod to debug folder" AfterTargets="Build">
		<Message Text="Copying the mod to the plugins folder $(OutputPath)$(ProjectName).dll -&gt; $(PluginsPath)" Importance="High" />
		<Copy SourceFiles="$(OutputPath)$(ProjectName).dll" DestinationFolder="$(PluginsPath)" ContinueOnError="false" />
		<Copy SourceFiles="$(OutputPath)$(ProjectName).pdb" DestinationFolder="$(PluginsPath)" ContinueOnError="false" />
		<Copy SourceFiles="$(OutputPath)Archipelago.MultiClient.Net.dll" DestinationFolder="$(PluginsPath)" ContinueOnError="false" />
		<Copy SourceFiles="$(OutputPath)KaitoKid.ArchipelagoUtilities.Net.dll" DestinationFolder="$(PluginsPath)" ContinueOnError="false" />
		<Copy SourceFiles="$(OutputPath)KaitoKid.Utilities.Interfaces.dll" DestinationFolder="$(PluginsPath)" ContinueOnError="false" />
		<!--<Copy SourceFiles="$(OutputPath)IdTables\silksong_item_table.json" DestinationFolder="$(PluginsPath)IdTables\" ContinueOnError="false" />-->
		<!--<Copy SourceFiles="$(OutputPath)IdTables\silksong_location_table.json" DestinationFolder="$(PluginsPath)IdTables\" ContinueOnError="false" />-->
		<Message Text="Copied mod files" Importance="High" />
	</Target>
</Project>